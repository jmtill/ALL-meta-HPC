#!/bin/bash
# Generated by allmeta.hazel_hpc.sweep from profiles.toml. Edit the sweep TOML or profile, not this file.
#SBATCH --job-name={job_name}
#SBATCH --output={log_dir}/logs/{sweep}/{block}/%x.%A_%a.out
#SBATCH --error={log_dir}/logs/{sweep}/{block}/%x.%A_%a.err
#SBATCH --partition={partition}
{qos_line}#SBATCH --ntasks=1
#SBATCH --cpus-per-task={cpus}
#SBATCH --mem={mem}
#SBATCH --time={time}
#SBATCH --array={array}
#SBATCH --signal=B:USR1@300

set -eo pipefail
source ~/.bashrc
conda activate {env}

export OMP_NUM_THREADS=${{SLURM_CPUS_PER_TASK:-1}}
export MKL_NUM_THREADS=$OMP_NUM_THREADS OPENBLAS_NUM_THREADS=$OMP_NUM_THREADS NUMEXPR_NUM_THREADS=$OMP_NUM_THREADS
export PYTHONPATH={code_dir}:{code_dir}/src:${{PYTHONPATH:-}}   # allmeta at the repo root or under src/

cd {code_dir}
python -m allmeta.hazel_hpc.worker {project_dir}/sweeps/{sweep}/{block} \
    --index "$SLURM_ARRAY_TASK_ID" --per-task {per_task} --runs {project_dir}/runs/{sweep}/{block} &
PID=$!
trap 'kill -USR1 $PID 2>/dev/null' TERM USR1   # worker finishes the current cell, then exits 75

set +e
while true; do
    wait $PID; EXIT=$?
    kill -0 $PID 2>/dev/null || break
done
exit $EXIT
